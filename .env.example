# Publishable configuration (client-side, safe to commit).
# All secrets — database URL, service-role key, LLM API token, project
# attribution — are managed by Enter Cloud and read server-side inside
# backend functions via Deno.env.get(...). Nothing private ever ships in
# this file or in frontend code.

# Enter Analytics (optional page/event analytics)
VITE_ENTER_ANALYTICS_ENABLED=true
VITE_ENTER_ANALYTICS_TOKEN=
VITE_ENTER_PROJECT_ID=
VITE_ENTER_ANALYTICS_ENDPOINT=https://api.enter.pro
VITE_ENTER_ANALYTICS_DEFINITIONS_ENDPOINT=
VITE_ENTER_ANALYTICS_DEBUG=false
