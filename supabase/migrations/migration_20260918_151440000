create or replace function public.resolveai_handle_new_user()
returns trigger
language plpgsql
security definer
set search_path = public
as $$
begin
  if new.raw_user_meta_data ? 'role' then
    insert into public.resolveai_staff (user_id, name, role)
    values (new.id, coalesce(new.raw_user_meta_data->>'name', 'Support Agent'), new.raw_user_meta_data->>'role')
    on conflict (user_id) do nothing;
  elsif new.raw_user_meta_data ? 'customer_code' then
    update public.resolveai_customers set user_id = new.id
    where customer_code = new.raw_user_meta_data->>'customer_code';
  end if;
  return new;
end;
$$;
create trigger on_auth_user_created after insert on auth.users
  for each row execute function public.resolveai_handle_new_user();